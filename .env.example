# Fonte dos dados: deixe vazio para usar o Supabase. "mock" = dados de exemplo no navegador (só testes)
NEXT_PUBLIC_DATA_SOURCE=

# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Chave do servidor para as funções do banco (64 caracteres aleatórios).
# O hash dela fica em private.config no banco (veja supabase/migrations).
APP_DB_SECRET=

# Assina o cookie de login (32+ caracteres aleatórios)
AUTH_SECRET=

# Endereço público do app, usado nos links dos e-mails (ex.: https://prisma.vercel.app)
APP_URL=

# Kiwify: token do webhook e (opcional) ids dos produtos do Prisma, separados por vírgula
KIWIFY_WEBHOOK_TOKEN=
KIWIFY_PRODUCT_IDS=

# Link da página de compra na Kiwify (botão "Renovar assinatura")
NEXT_PUBLIC_CHECKOUT_URL=
